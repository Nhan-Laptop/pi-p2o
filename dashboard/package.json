{
  "name": "p2o-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only dashboard client for pi-p2o committed records. Build-time only: it emits static assets, and the extension never depends on it at runtime.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
