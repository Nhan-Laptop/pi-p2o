{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true, "noEmitOnError": true,
    "types": ["node"], "typeRoots": ["../../node_modules/@types"],
    "rootDir": "../..", "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": [
    "./**/*.ts",
    "../../src/runtime/**/*.ts",
    "../../src/policy/targets.ts",
    "../../src/application/authority.ts",
    "../../src/interface/supervisor-backend.ts"
  ]
}
