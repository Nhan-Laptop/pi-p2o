{
  "name": "pi-p2o",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Scoped Planner/Engine/Worker assessment: current Pi plans, visible workers investigate, opt-in semantic wake loop and isolated executors. Includes an evidence-oriented security-research skill library.",
  "license": "UNLICENSED",
  "keywords": ["pi-package", "security-assessment"],
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./extensions/p2o/index.ts"], "skills": ["./skills"] },
  "files": ["src/", "extensions/", "skills/", "research/", "scripts/", "templates/", "docs/", "bench/README.md", "bench/lib/", "bench/fixtures/", "planning_update.md", "HANDOFFS.md", "README.md", "!**/.p2o-state/**", "!**/.p2o-reports/**", "!**/.p2o-export-*/**", "!**/p2o-run-*/**", "!**/assessment.sqlite*", "!**/writer.lock*", "!**/artifact-*.txt", "!**/checkpoint-*.json", "!**/ticket-p2o-*.json"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check:build": "node --input-type=module -e \"await import('./dist/extensions/p2o/index.js'); console.log('build import OK')\"",
    "test": "npm run typecheck && npm run build && npm run check:build && vitest run && npm run check:python",
    "test:sandbox": "P2O_TEST_DOCKER=1 vitest run tests/minimal/docker.test.ts tests/minimal/docker-extension.test.ts tests/minimal/isolated-docker.test.ts tests/minimal/native.test.ts",
    "test:herdr": "P2O_TEST_HERDR=1 vitest run tests/minimal/herdr-live.test.ts",
    "check:render": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/render_research.py --check",
    "check:orange": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/orange_research.py --check",
    "check:orange-validate": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/orange_research.py --validate",
    "check:library": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/validate_library.py",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v",
    "check:python": "npm run check:render && npm run check:orange && npm run check:orange-validate && npm run check:library && npm run test:python"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true }, "@earendil-works/pi-tui": { "optional": true }, "typebox": { "optional": true } },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
